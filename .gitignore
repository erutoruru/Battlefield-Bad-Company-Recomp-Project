# Game files: never commit (supplied by each player)
assets/*
!assets/PUT_GAME_FILES_HERE.txt

# Generated from default.xex by rexglue codegen (translated game code).
# generated/rexglue.cmake is SDK boilerplate (no game code) and is committed.
generated/*
!generated/rexglue.cmake
metadata/
image_dump.bin

# Build output, SDK, logs, user data
out/
tools/rexglue/
logs/
*.exe
*.pdb
launcher.json
bfbc.toml
